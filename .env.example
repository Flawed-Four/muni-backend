APP_ENV=development
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=muni
DB_PASSWORD=muni
DB_NAME=muni
DB_SSLMODE=disable

SESSION_TTL=24h

# Local Mailpit from `make docker-up`, UI at http://localhost:8025.
# With a real provider use SMTP_TLS_MODE=starttls (port 587) or tls (port 465).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@muni.local
SMTP_FROM_NAME=Muni
SMTP_TLS_MODE=none
SMTP_TIMEOUT=10s

# Local Redis from `make docker-up`. Set REDIS_PORT to another port if 6379 is taken.
# A managed provider usually needs REDIS_PASSWORD and REDIS_TLS=true.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_TIMEOUT=3s

# Local Chroma from `make docker-up`. Set CHROMA_PORT to another port if 8000 is taken.
# Chroma Cloud: CHROMA_HOST=api.trychroma.com, CHROMA_PORT=443, CHROMA_TLS=true, plus the
# API key, tenant and database from its dashboard.
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_TLS=false
CHROMA_API_KEY=
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_TIMEOUT=10s

# Gemini API key from https://aistudio.google.com/apikey. The app boots without it
# until something uses domain.LanguageModel.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT=120s
GEMINI_MAX_RETRIES=2
