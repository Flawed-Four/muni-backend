APP_ENV=development
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=muni
DB_PASSWORD=muni
DB_NAME=muni
DB_SSLMODE=disable

SESSION_TTL=24h

# Local Mailpit from `make docker-up`, UI at http://localhost:8025.
# With a real provider use SMTP_TLS_MODE=starttls (port 587) or tls (port 465).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@muni.local
SMTP_FROM_NAME=Muni
SMTP_TLS_MODE=none
SMTP_TIMEOUT=10s
